@page "/checkout"
@using ProiectCE.Client.Services
@inject CartService CartService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm p-4">
                <h4 class="mb-4">📦 Detalii Comandă</h4>

                <div class="mb-3">
                    <label class="form-label fw-bold">Nume și Prenume</label>
                    <input type="text" class="form-control" @bind="customerName" placeholder="Ex: Ion Popescu" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Adresa de livrare</label>
                    <textarea class="form-control" @bind="address" rows="2" placeholder="Strada, Număr, Bloc, Oraș..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Modalitate de livrare</label>
                    <select class="form-select" @bind="deliveryMethod">
                        <option value="Curier">Curier Rapid (24-48h)</option>
                        <option value="Ridicare">Ridicare Personală</option>
                    </select>
                </div>

                <h4 class="mt-4 mb-4">💳 Detalii Plată</h4>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold">Numele de pe card</label>
                        <input type="text" class="form-control" placeholder="EX: ION POPESCU" @bind="cardHolderName" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Număr Card</label>
                        <input type="text" class="form-control" placeholder="0000 0000 0000 0000" @bind="cardNumber" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Data Expirării</label>
                        <input type="text" class="form-control" placeholder="LL / AA" @bind="expiryDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Cod CVC / CVV</label>
                        <input type="password" class="form-control" placeholder="123" maxlength="3" @bind="cvc" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm p-4 bg-light sticky-top" style="top: 20px;">
                <h4>🎁 Cod Bonus</h4>
                <div class="input-group mb-3">
                    <input type="text" class="form-control" @bind="bonusCode" placeholder="Ex: REDUCERE10" />
                    <button class="btn btn-outline-primary" @onclick="ApplyBonus">Aplică</button>
                </div>

                <hr />
                <h5 class="mb-3">Sumar Comandă</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal:</span>
                    <span>@CartService.GetSubTotal() RON</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Livrare:</span>
                    <span>@CartService.GetDeliveryCost() RON</span>
                </div>
                @if (CartService.GetDiscount() > 0)
                {
                    <div class="d-flex justify-content-between text-danger fw-bold mb-2">
                        <span>Reducere (@CartService.AppliedBonusCode):</span>
                        <span>- @CartService.GetDiscount() RON</span>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between h4">
                    <span>Total:</span>
                    <span class="text-primary fw-bold">@CartService.GetTotal() RON</span>
                </div>

                <button class="btn btn-success btn-lg w-100 mt-4 shadow-sm" @onclick="FinalizeOrder">
                    Plătește @CartService.GetTotal() RON
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string customerName = "";
    private string address = "";
    private string deliveryMethod = "Curier";

    private string cardHolderName = "";
    private string cardNumber = "";
    private string expiryDate = "";
    private string cvc = "";

    private string bonusCode = "";

    private void ApplyBonus()
    {
        if (CartService.ApplyBonusCode(bonusCode))
        {
            JS.InvokeVoidAsync("alert", "Cod aplicat cu succes!");
        }
        else
        {
            JS.InvokeVoidAsync("alert", "Cod invalid sau condiții neîndeplinite.");
        }
    }

    private async Task FinalizeOrder()
    {
        // Validare: Verificăm dacă toate câmpurile noi sunt completate
        if (string.IsNullOrWhiteSpace(customerName) ||
            string.IsNullOrWhiteSpace(address) ||
            string.IsNullOrWhiteSpace(cardNumber) ||
            string.IsNullOrWhiteSpace(expiryDate) ||
            string.IsNullOrWhiteSpace(cvc))
        {
            await JS.InvokeVoidAsync("alert", "Te rugăm să completezi toate datele de livrare și plată!");
            return;
        }

        try
        {
            // Aici se simulează procesarea plății
            bool isSuccess = true;

            if (isSuccess)
            {
                CartService.ClearCart();
                NavManager.NavigateTo("/order-result/success");
            }
            else
            {
                NavManager.NavigateTo("/order-result/failure");
            }
        }
        catch (Exception)
        {
            NavManager.NavigateTo("/order-result/failure");
        }
    }
}
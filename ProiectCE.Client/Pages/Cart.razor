@page "/cart"
@using ProiectCE.Client.Services
@using ProiectCE.Client.Models
@inject CartService CartService
@implements IDisposable

<div class="container mt-4">
    <h3>🛒 Coșul meu de cumpărături</h3>

    @if (!CartService.CartItems.Any())
    {
        <div class="alert alert-info mt-3">
            Coșul este gol. Mergi la <a href="products" class="alert-link">produse</a> pentru a alege ceva.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mt-3 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Produs</th>
                        <th>Preț Unitar</th>
                        <th>Cantitate</th>
                        <th>Subtotal</th>
                        <th>Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in CartService.CartItems)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold">@item.Product.Name</span><br />
                                <small class="text-muted">Furnizor: @item.Product.Supplier</small>
                            </td>
                            <td>@item.Product.Price RON</td>
                            <td>
                                <span class="badge bg-secondary">@item.Quantity buc.</span>
                            </td>
                            <td>@(item.Product.Price * item.Quantity) RON</td>
                            <td>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Sterge(item)">
                                    <i class="bi bi-trash"></i> Șterge
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row justify-content-end mt-4 mb-5">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-header bg-white border-bottom-0 pt-3">
                        <h5 class="mb-0 text-secondary">Sumar Comandă</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal produse:</span>
                            <span class="fw-bold">@CartService.GetSubTotal() RON</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Cost Livrare:</span>
                            @if (CartService.GetDeliveryCost() == 0)
                            {
                                <span class="text-success fw-bold">Gratuit</span>
                            }
                            else
                            {
                                <span>@CartService.GetDeliveryCost() RON</span>
                            }
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="h5 mb-0">Total de plată:</span>
                            <span class="h4 text-primary mb-0 fw-bold">@CartService.GetGrandTotal() RON</span>
                        </div>

                        <button class="btn btn-primary w-100 btn-lg shadow-sm">
                            Finalizează Comanda <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 text-center text-muted small pb-3">
                        Livrare gratuită la comenzi peste 500 RON!
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    private void Sterge(CartItem item)
    {
        CartService.StergeProdus(item);
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
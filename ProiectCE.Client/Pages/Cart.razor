@page "/cart"
@using ProiectCE.Client.Services
@using ProiectCE.Client.Models
@inject CartService CartService
@inject NavigationManager NavManager
@implements IDisposable

<div class="container mt-4">
    <h3>🛒 Coșul meu de cumpărături</h3>

    @if (!CartService.CartItems.Any())
    {
        <p>Coșul este gol. Mergi la <a href="products">produse</a> pentru a alege ceva.</p>
    }
    else
    {
        <table class="table table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Produs</th>
                    <th>Preț Unitar</th>
                    <th>Cantitate</th>
                    <th>Subtotal</th>
                    <th>Acțiuni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in CartService.CartItems)
                {
                    <tr>
                        <td>@item.Product.Name</td>
                        <td>@item.Product.Price RON</td>
                        <td>@item.Quantity</td>
                        <td>@(item.Product.Price * item.Quantity) RON</td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => Sterge(item)">
                                <i class="bi bi-trash"></i> Șterge
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-end mt-4">
            <div class="card p-3 shadow-sm border-primary">
                <div class="mb-2">Subtotal: @CartService.GetSubTotal() RON</div>
                <div class="mb-2 text-success">Livrare: @(CartService.GetDeliveryCost() == 0 ? "Gratuit" : CartService.GetDeliveryCost() + " RON")</div>
                <h4>Total de plată: <span class="text-primary">@CartService.GetTotal() RON</span></h4>

                @* Adăugăm acțiunea de navigare aici *@
                <button class="btn btn-primary btn-lg mt-2" @onclick='() => NavManager.NavigateTo("/checkout")'>
                    Continuă spre Finalizare <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    private void Sterge(CartItem item)
    {
        CartService.StergeProdus(item);
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
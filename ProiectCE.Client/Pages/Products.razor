@page "/products"
@using ProiectCE.Client.Models
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Catalog Produse</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Catalog Produse</h1>
        
        <AuthorizeView Roles="admin">
            <Authorized>
                <a href="product/add" class="btn btn-success">
                    <span class="bi bi-plus-circle"></span> Adaugă Produs
                </a>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="row mb-4">
        <div class="col-md-8">
            <div class="input-group">
                <input @bind="searchText" class="form-control" placeholder="Caută produs..." @onkeyup="HandleSearch" />
                <button class="btn btn-primary" @onclick="SearchProducts">Caută</button>
            </div>
        </div>
    </div>

    @if (products == null)
    {
        <p>Se încarcă...</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var product in products)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <span class="badge bg-info text-dark mb-2">@product.Category?.Name</span>
                            <h4 class="text-primary">@product.Price RON</h4>
                            <p class="card-text text-muted small">@product.Description</p>
                        </div>
                        
                        <AuthorizeView Roles="admin">
                            <Authorized>
                                <div class="card-footer bg-white border-top-0 d-flex gap-2">
                                    <a href="product/edit/@product.Id" class="btn btn-warning btn-sm flex-fill">Editează</a>
                                    <button class="btn btn-danger btn-sm flex-fill" @onclick="() => DeleteProduct(product.Id)">Șterge</button>
                                </div>
                            </Authorized>
                            <NotAuthorized>
                                <div class="card-footer bg-white border-top-0">
                                    <a href="product/details/@product.Id" class="btn btn-outline-primary w-100">Detalii</a>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private Product[]? products;
    private string searchText = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        // ATENȚIE: Verifică portul backend-ului!
        products = await Http.GetFromJsonAsync<Product[]>("https://localhost:7051/api/Products");
    }

    private async Task SearchProducts()
    {
        if (string.IsNullOrWhiteSpace(searchText)) await LoadProducts();
        else products = await Http.GetFromJsonAsync<Product[]>($"https://localhost:7051/api/Products/search?q={searchText}");
    }

    private async Task HandleSearch(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchProducts(); }

    // FUNCȚIA DE ȘTERGERE
    private async Task DeleteProduct(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Sigur vrei să ștergi acest produs?");
        if (confirmed)
        {
            // Token-ul este adăugat automat de AuthStateProvider
            var response = await Http.DeleteAsync($"https://localhost:7051/api/Products/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadProducts(); // Reîmprospătăm lista
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Eroare la ștergere!");
            }
        }
    }
}
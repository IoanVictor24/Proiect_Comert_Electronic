@using ProiectCE.Client.Services
@inject CartService CartService
@inject WishlistService WishlistService
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Magazin Electronic</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Acasă
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="products">
                <span class="bi bi-bag-fill-nav-menu" aria-hidden="true"></span> Catalog Produse
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cart">
                <span class="bi bi-cart-fill" aria-hidden="true"></span> Coș (@CartService.CartItems.Count)
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="wishlist">
                <span class="bi bi-heart-fill" aria-hidden="true"></span> Wishlist (@WishlistService.Wishlist.Count)
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-4">
            <span class="text-light small text-uppercase fw-bold ms-2">Contul Meu</span>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Autentificare
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="register">
                <span class="bi bi-person-plus-fill-nav-menu" aria-hidden="true"></span> Înregistrare
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    protected override async Task OnInitializedAsync()
    {
        // Ne asigurăm că încărcăm datele din LocalStorage ca să avem numerele corecte
        await WishlistService.GetWishlist();

        // Ne abonăm la modificări
        CartService.OnChange += StateHasChanged;
        WishlistService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        // Curățăm memoria
        CartService.OnChange -= StateHasChanged;
        WishlistService.OnChange -= StateHasChanged;
    }
}